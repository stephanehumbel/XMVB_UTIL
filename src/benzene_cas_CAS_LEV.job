#!/bin/sh
# Script genere automatiquement a partir de subgms
#
#$ -N benzene_cas_CAS_LEV
#
#SBATCH --job-name=benzene_cas_CAS_LEV
#SBATCH --cpus-per-task=8
#SBATCH --mem=3000
#***************************
#DO NOT MODIFY THESE OPTIONS
#SBATCH --nodes=1
#SBATCH --ntasks=1
#***************************


#$ -cwd
#$ -S /bin/sh
 hhomedir=`pwd`
 nnode=`hostname`
echo "--------SLURM EXECUTION------ -",date
echo "Variables"
echo "Running on        : $nnode  "
echo "targetdir         : $hhomedir "
echo "VBDIR            : /home/humbel/xmvb3_2/"
echo "TMPDIR            : $TMPDIR"
echo "I am in           : $PWD"
#echo "SLURM_JOB_ID :  ${SLURM_JOB_ID}"

# source /usr/share/Modules/init/sh
# save previous run
if [ -s benzene_cas_CAS_LEV.orb ] ; then
 set  echo
   cp benzene_cas_CAS_LEV.orb benzene_cas_CAS_LEV.orb~
 unset  echo
fi
if [ -s benzene_cas_CAS_LEV.xmo ] ; then
 set  echo
   cp benzene_cas_CAS_LEV.xmo benzene_cas_CAS_LEV.xmo~
 unset  echo
fi
if [ -s benzene_cas_CAS_LEV.log ] ; then
 set  echo
   cp benzene_cas_CAS_LEV.log benzene_cas_CAS_LEV.log~
 unset  echo
fi

set echo
export OMP_NUM_THREADS=8
export OMP_STACKSIZE=3000M
cp  $HOMEDIR/benzene_cas_CAS_LEV.xmi  $TMPDIR/benzene_cas_CAS_LEV.xmi
if [ -s benzene_cas_CAS_LEV.gus ] ; then
    cp  $HOMEDIR/benzene_cas_CAS_LEV.gus  $TMPDIR/benzene_cas_CAS_LEV.gus
else 
# use .orb as a .gus
    cp  $HOMEDIR/benzene_cas_CAS_LEV.orb  $TMPDIR/benzene_cas_CAS_LEV.gus
fi

cd $TMPDIR 
#time (/home/humbel/xmvb3_2//bin/preint                 benzene_cas_CAS_LEV                      )
#pwd;ls -lrt |head -3
time (/home/humbel/xmvb3_2//bin/xmvb                   benzene_cas_CAS_LEV                      )
pwd;ls -lrt |head -3
cd $HOMEDIR 
#time (rungms_                     benzene_cas_CAS_LEV  1  > benzene_cas_CAS_LEV.log)
# On doit rappatrier à la main le .xmo et les wfn (si necessaire)
cp  $TMPDIR/benzene_cas_CAS_LEV.orb  $HOMEDIR/
cp  $TMPDIR/benzene_cas_CAS_LEV.xmo  $HOMEDIR/
cp  $TMPDIR/benzene_cas_CAS_LEV.xdat  $HOMEDIR/
# join slurm and xmo
cat slurm-${SLURM_JOB_ID}.out benzene_cas_CAS_LEV.xmo >> benzene_cas_CAS_LEV.xmo
unset echo
