#!/bin/sh
# Script genere automatiquement a partir de subgms
#
#$ -N TEST_HF
#
#SBATCH --job-name=TEST_HF
#SBATCH --cpus-per-task=8
#SBATCH --mem=40000
#***************************
#DO NOT MODIFY THESE OPTIONS
#SBATCH --nodes=1
#SBATCH --ntasks=1
#***************************


#$ -cwd
#$ -S /bin/sh
 hhomedir=`pwd`
 nnode=`hostname`
echo "--------SLURM EXECUTION------ -",date
echo "Variables"
echo "Running on        : $nnode  "
echo "targetdir         : $hhomedir "
echo "VBDIR            : /home/humbel/xmvb3_2/"
echo "TMPDIR            : $TMPDIR"
echo "I am in           : $PWD"
#echo "SLURM_JOB_ID :  ${SLURM_JOB_ID}"

# source /usr/share/Modules/init/sh
# save previous run
if [ -s TEST_HF.orb ] ; then
 set  echo
   cp TEST_HF.orb TEST_HF.orb~
 unset  echo
fi
if [ -s TEST_HF.xmo ] ; then
 set  echo
   cp TEST_HF.xmo TEST_HF.xmo~
 unset  echo
fi
if [ -s TEST_HF.log ] ; then
 set  echo
   cp TEST_HF.log TEST_HF.log~
 unset  echo
fi

set echo
export OMP_NUM_THREADS=8
export OMP_STACKSIZE=10000
cp  $HOMEDIR/TEST_HF.xmi  $TMPDIR/TEST_HF.xmi
touch $TMPDIR/TEST_HF.orb
touch $HOMEDIR/TEST_HF.orb
if [ -s TEST_HF.gus ] ; then
    cp  $HOMEDIR/TEST_HF.gus  $TMPDIR/TEST_HF.gus
else 
# use .orb as a .gus
    cp  $HOMEDIR/TEST_HF.orb  $TMPDIR/TEST_HF.gus
fi

cd $TMPDIR 
#time (/home/humbel/xmvb3_2//bin/preint                 TEST_HF                      )
#pwd;ls -lrt |head -3
time (/home/humbel/xmvb3_2//bin/xmvb                   TEST_HF                      )
pwd;ls -lrt |head -3
cd $HOMEDIR 
#time (rungms_                     TEST_HF  1  > TEST_HF.log)
# On doit rappatrier à la main le .xmo et les wfn (si necessaire)
cp  $TMPDIR/TEST_HF.orb  $HOMEDIR/
cp  $TMPDIR/TEST_HF.xmo  $HOMEDIR/
cp  $TMPDIR/TEST_HF.xdat  $HOMEDIR/
# join slurm and xmo
cat slurm-${SLURM_JOB_ID}.out TEST_HF.xmo >> TEST_HF.xmo
unset echo
