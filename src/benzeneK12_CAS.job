#!/bin/sh
# Script genere automatiquement a partir de subgms
#
#$ -N benzeneK12_CAS
#
#SBATCH --job-name=benzeneK12_CAS
#SBATCH --cpus-per-task=8
#SBATCH --mem=3000
#***************************
#DO NOT MODIFY THESE OPTIONS
#SBATCH --nodes=1
#SBATCH --ntasks=1
#***************************


#$ -cwd
#$ -S /bin/sh
 hhomedir=`pwd`
 nnode=`hostname`
echo "--------SLURM EXECUTION------ -",date
echo "Variables"
echo "Running on        : $nnode  "
echo "targetdir         : $hhomedir "
echo "VBDIR            : /home/humbel/xmvb3_2/"
echo "TMPDIR            : $TMPDIR"
echo "I am in           : $PWD"
#echo "SLURM_JOB_ID :  ${SLURM_JOB_ID}"

# source /usr/share/Modules/init/sh
# save previous run
if [ -s benzeneK12_CAS.orb ] ; then
 set  echo
   cp benzeneK12_CAS.orb benzeneK12_CAS.orb~
 unset  echo
fi
if [ -s benzeneK12_CAS.xmo ] ; then
 set  echo
   cp benzeneK12_CAS.xmo benzeneK12_CAS.xmo~
 unset  echo
fi
if [ -s benzeneK12_CAS.log ] ; then
 set  echo
   cp benzeneK12_CAS.log benzeneK12_CAS.log~
 unset  echo
fi

set echo
export OMP_NUM_THREADS=8
export OMP_STACKSIZE=3000M
cp  $HOMEDIR/benzeneK12_CAS.xmi  $TMPDIR/benzeneK12_CAS.xmi
if [ -s benzeneK12_CAS.gus ] ; then
    cp  $HOMEDIR/benzeneK12_CAS.gus  $TMPDIR/benzeneK12_CAS.gus
else 
# use .orb as a .gus
    cp  $HOMEDIR/benzeneK12_CAS.orb  $TMPDIR/benzeneK12_CAS.gus
fi

cd $TMPDIR 
#time (/home/humbel/xmvb3_2//bin/preint                 benzeneK12_CAS                      )
#pwd;ls -lrt |head -3
time (/home/humbel/xmvb3_2//bin/xmvb                   benzeneK12_CAS                      )
pwd;ls -lrt |head -3
cd $HOMEDIR 
#time (rungms_                     benzeneK12_CAS  1  > benzeneK12_CAS.log)
# On doit rappatrier à la main le .xmo et les wfn (si necessaire)
cp  $TMPDIR/benzeneK12_CAS.orb  $HOMEDIR/
cp  $TMPDIR/benzeneK12_CAS.xmo  $HOMEDIR/
cp  $TMPDIR/benzeneK12_CAS.xdat  $HOMEDIR/
# join slurm and xmo
cat slurm-${SLURM_JOB_ID}.out benzeneK12_CAS.xmo >> benzeneK12_CAS.xmo
unset echo
