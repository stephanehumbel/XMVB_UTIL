#!/bin/sh
# Script genere automatiquement a partir de subgms
#
#$ -N acro_2x2_sigmaHF
#
#SBATCH --job-name=acro_2x2_sigmaHF
#SBATCH --cpus-per-task=8
#SBATCH --mem=3000
#***************************
#DO NOT MODIFY THESE OPTIONS
#SBATCH --nodes=1
#SBATCH --ntasks=1
#***************************


#$ -cwd
#$ -S /bin/sh
 hhomedir=`pwd`
 nnode=`hostname`
echo "--------SLURM EXECUTION------ -",date
echo "Variables"
echo "Running on        : $nnode  "
echo "targetdir         : $hhomedir "
echo "VBDIR            : /home/humbel/xmvb3_2/"
echo "TMPDIR            : $TMPDIR"
echo "I am in           : $PWD"
#echo "SLURM_JOB_ID :  ${SLURM_JOB_ID}"

# source /usr/share/Modules/init/sh
# save previous run
if [ -s acro_2x2_sigmaHF.orb ] ; then
 set  echo
   cp acro_2x2_sigmaHF.orb acro_2x2_sigmaHF.orb~
 unset  echo
fi
if [ -s acro_2x2_sigmaHF.xmo ] ; then
 set  echo
   cp acro_2x2_sigmaHF.xmo acro_2x2_sigmaHF.xmo~
 unset  echo
fi
if [ -s acro_2x2_sigmaHF.log ] ; then
 set  echo
   cp acro_2x2_sigmaHF.log acro_2x2_sigmaHF.log~
 unset  echo
fi

set echo
export OMP_NUM_THREADS=8
export OMP_STACKSIZE=3000M
cp  $HOMEDIR/acro_2x2_sigmaHF.xmi  $TMPDIR/acro_2x2_sigmaHF.xmi
if [ -s acro_2x2_sigmaHF.gus ] ; then
    cp  $HOMEDIR/acro_2x2_sigmaHF.gus  $TMPDIR/acro_2x2_sigmaHF.gus
else 
# use .orb as a .gus
    cp  $HOMEDIR/acro_2x2_sigmaHF.orb  $TMPDIR/acro_2x2_sigmaHF.gus
fi

cd $TMPDIR 
#time (/home/humbel/xmvb3_2//bin/preint                 acro_2x2_sigmaHF                      )
#pwd;ls -lrt |head -3
time (/home/humbel/xmvb3_2//bin/xmvb                   acro_2x2_sigmaHF                      )
pwd;ls -lrt |head -3
cd $HOMEDIR 
#time (rungms_                     acro_2x2_sigmaHF  1  > acro_2x2_sigmaHF.log)
# On doit rappatrier à la main le .xmo et les wfn (si necessaire)
cp  $TMPDIR/acro_2x2_sigmaHF.orb  $HOMEDIR/
cp  $TMPDIR/acro_2x2_sigmaHF.xmo  $HOMEDIR/
cp  $TMPDIR/acro_2x2_sigmaHF.xdat  $HOMEDIR/
# join slurm and xmo
cat slurm-${SLURM_JOB_ID}.out acro_2x2_sigmaHF.xmo >> acro_2x2_sigmaHF.xmo
unset echo
