#!/bin/sh
# Script genere automatiquement a partir de subgms
#
#$ -N b_dK12
#
#SBATCH --job-name=b_dK12
#SBATCH --cpus-per-task=8
#SBATCH --mem=12000
#***************************
#DO NOT MODIFY THESE OPTIONS
#SBATCH --nodes=1
#SBATCH --ntasks=1
#***************************


#$ -cwd
#$ -S /bin/sh
 hhomedir=`pwd`
 nnode=`hostname`
echo "--------SLURM EXECUTION------ -",date
echo "Variables"
echo "Running on        : $nnode  "
echo "targetdir         : $hhomedir "
echo "VBDIR            : /home/humbel/xmvb3_2/"
echo "TMPDIR            : $TMPDIR"
echo "I am in           : $PWD"
#echo "SLURM_JOB_ID :  ${SLURM_JOB_ID}"

# source /usr/share/Modules/init/sh
# save previous run
if [ -s b_dK12.orb ] ; then
 set  echo
   cp b_dK12.orb b_dK12.orb~
 unset  echo
fi
if [ -s b_dK12.xmo ] ; then
 set  echo
   cp b_dK12.xmo b_dK12.xmo~
 unset  echo
fi
if [ -s b_dK12.log ] ; then
 set  echo
   cp b_dK12.log b_dK12.log~
 unset  echo
fi

set echo
export OMP_NUM_THREADS=8
export OMP_STACKSIZE=12000M
cp  $HOMEDIR/b_dK12.xmi  $TMPDIR/b_dK12.xmi
if [ -s b_dK12.gus ] ; then
    cp  $HOMEDIR/b_dK12.gus  $TMPDIR/b_dK12.gus
else 
# use .orb as a .gus
    cp  $HOMEDIR/b_dK12.orb  $TMPDIR/b_dK12.gus
fi

cd $TMPDIR 
#time (/home/humbel/xmvb3_2//bin/preint                 b_dK12                      )
#pwd;ls -lrt |head -3
time (/home/humbel/xmvb3_2//bin/xmvb                   b_dK12                      )
pwd;ls -lrt |head -3
cd $HOMEDIR 
#time (rungms_                     b_dK12  1  > b_dK12.log)
# On doit rappatrier à la main le .xmo et les wfn (si necessaire)
cp  $TMPDIR/b_dK12.orb  $HOMEDIR/
cp  $TMPDIR/b_dK12.xmo  $HOMEDIR/
cp  $TMPDIR/b_dK12.xdat  $HOMEDIR/
# join slurm and xmo
cat slurm-${SLURM_JOB_ID}.out b_dK12.xmo >> b_dK12.xmo
unset echo
