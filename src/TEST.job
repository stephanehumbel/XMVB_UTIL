#!/bin/sh
# Script genere automatiquement a partir de subgms
#
#$ -N TEST
#
#SBATCH --job-name=TEST
#SBATCH --cpus-per-task=8
#SBATCH --mem=40000
#***************************
#DO NOT MODIFY THESE OPTIONS
#SBATCH --nodes=1
#SBATCH --ntasks=1
#***************************


#$ -cwd
#$ -S /bin/sh
 hhomedir=`pwd`
 nnode=`hostname`
echo "--------SLURM EXECUTION------ -",date
echo "Variables"
echo "Running on        : $nnode  "
echo "targetdir         : $hhomedir "
echo "VBDIR            : /home/humbel/xmvb3_2/"
echo "TMPDIR            : $TMPDIR"
echo "I am in           : $PWD"
#echo "SLURM_JOB_ID :  ${SLURM_JOB_ID}"

# source /usr/share/Modules/init/sh
# save previous run
if [ -s TEST.orb ] ; then
 set  echo
   cp TEST.orb TEST.orb~
 unset  echo
fi
if [ -s TEST.xmo ] ; then
 set  echo
   cp TEST.xmo TEST.xmo~
 unset  echo
fi
if [ -s TEST.log ] ; then
 set  echo
   cp TEST.log TEST.log~
 unset  echo
fi

set echo
export OMP_NUM_THREADS=8
export OMP_STACKSIZE=10000
cp  $HOMEDIR/TEST.xmi  $TMPDIR/TEST.xmi
touch $TMPDIR/TEST.orb
touch $HOMEDIR/TEST.orb
if [ -s TEST.gus ] ; then
    cp  $HOMEDIR/TEST.gus  $TMPDIR/TEST.gus
else 
# use .orb as a .gus
    cp  $HOMEDIR/TEST.orb  $TMPDIR/TEST.gus
fi

cd $TMPDIR 
#time (/home/humbel/xmvb3_2//bin/preint                 TEST                      )
#pwd;ls -lrt |head -3
time (/home/humbel/xmvb3_2//bin/xmvb                   TEST                      )
pwd;ls -lrt |head -3
cd $HOMEDIR 
#time (rungms_                     TEST  1  > TEST.log)
# On doit rappatrier à la main le .xmo et les wfn (si necessaire)
cp  $TMPDIR/TEST.orb  $HOMEDIR/
cp  $TMPDIR/TEST.xmo  $HOMEDIR/
cp  $TMPDIR/TEST.xdat  $HOMEDIR/
# join slurm and xmo
cat slurm-${SLURM_JOB_ID}.out TEST.xmo >> TEST.xmo
unset echo
